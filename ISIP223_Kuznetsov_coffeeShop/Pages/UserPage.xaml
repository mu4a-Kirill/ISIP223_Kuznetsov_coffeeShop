<Page x:Class="ISIP223_Kuznetsov_coffeeShop.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP223_Kuznetsov_coffeeShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Меню">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBlock Text="Поиск по названию:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbSearch" Width="150" Margin="10,0,0,0" TextChanged="TbSearch_TextChanged" ToolTip="Введите название товара"/>

            <TextBlock Text="Сортировка по цене:" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbSort" Width="150" Margin="10,0,0,0" SelectionChanged="CmbSort_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>

            <CheckBox x:Name="CbInStock" Content="Только в наличии" Margin="20,0,0,0" VerticalAlignment="Center" Checked="CbInStock_Checked" Unchecked="CbInStock_Unchecked"/>
            <Button x:Name="BtnMyOrders" Content="Мои заказы" Margin="20,0,0,0" Click="BtnMyOrders_Click" Width="120"/>
            <Button x:Name="BtnClear" Content="Сбросить фильтры" Margin="20,0,0,0" Click="BtnClear_Click" Width="140"/>
        </WrapPanel>

        <ListView x:Name="ListProducts" Grid.Row="1" Margin="10" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="2" CornerRadius="10" Margin="10" Padding="15" Width="200" Background="{DynamicResource BackgroundColor}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding Cost, StringFormat={}{0:N2} руб.}" FontSize="16" Foreground="{DynamicResource PrimaryColor}" TextAlignment="Center" FontWeight="Bold"/>

                            <TextBlock Text="{Binding StockQuantity, StringFormat=В наличии: {0} шт.}" FontSize="12" TextAlignment="Center" Margin="0,10,0,0" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>


