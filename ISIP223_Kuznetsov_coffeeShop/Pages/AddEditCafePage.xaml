<Page x:Class="ISIP223_Kuznetsov_coffeeShop.Pages.AddEditCafePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP223_Kuznetsov_coffeeShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Кофейня">
    <Grid Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock x:Name="TbTitle" Text="Кофейня" FontSize="20" HorizontalAlignment="Center" Margin="10"/>

            <Label Content="Название кофейни"/>
            <TextBox x:Name="TbName" ToolTip="Например: Шоколадница"/>

            <Label Content="Адрес"/>
            <TextBox x:Name="TbAddress" ToolTip="Улица, дом"/>

            <Label Content="Телефон"/>
            <TextBox x:Name="TbPhone" ToolTip="Контактный номер"/>

            <Button Content="Сохранить" Click="BtnSave_Click" Margin="0,20,0,10" Width="150"/>
            <Button Content="Отмена" Click="BtnCancel_Click" Width="150"/>
        </StackPanel>
    </Grid>
</Page>
