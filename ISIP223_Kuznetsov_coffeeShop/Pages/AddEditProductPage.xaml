<Page x:Class="ISIP223_Kuznetsov_coffeeShop.Pages.AddEditProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP223_Kuznetsov_coffeeShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
       Title="Товар">
    <Grid Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock x:Name="TbTitle" Text="Товар" FontSize="20" HorizontalAlignment="Center" Margin="10"/>

            <Label Content="Название товара"/>
            <TextBox x:Name="TbName" ToolTip="Введите название"/>

            <Label Content="Цена (руб.)"/>
            <TextBox x:Name="TbCost" ToolTip="Введите цену, например 150.50"/>

            <Label Content="Количество на складе"/>
            <TextBox x:Name="TbStock" ToolTip="Введите целое число"/>

            <Button Content="Сохранить" Click="BtnSave_Click" Width="150" Margin="0,20,0,10"/>
            <Button Content="Отмена" Click="BtnCancel_Click" Width="150"/>
        </StackPanel>
    </Grid>
</Page>