<Page x:Class="ISIP223_Kuznetsov_coffeeShop.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP223_Kuznetsov_coffeeShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="350" Margin="0,20">
            <StackPanel>
                <TextBlock Text="Смена пароля" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Label Content="Логин"/>
                <TextBox x:Name="TbLogin" ToolTip="Введите ваш логин"/>

                <Label Content="Старый пароль"/>
                <PasswordBox x:Name="PbOldPassword" ToolTip="Введите текущий пароль"/>

                <Label Content="Новый пароль"/>
                <PasswordBox x:Name="PbNewPassword" ToolTip="Минимум 6 символов, английская раскладка"/>

                <Label Content="Подтвердите новый пароль"/>
                <PasswordBox x:Name="PbConfirmPassword" ToolTip="Повторите новый пароль"/>

                <Button x:Name="BtnSave" Content="Сменить пароль" Click="BtnSave_Click" Margin="0,20,0,10" Width="200" HorizontalAlignment="Center"/>
                <Button x:Name="BtnBack" Content="Назад" Click="BtnBack_Click" Width="200" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>