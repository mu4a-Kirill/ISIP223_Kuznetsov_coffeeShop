<Page x:Class="ISIP223_Kuznetsov_coffeeShop.Pages.AddEditUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP223_Kuznetsov_coffeeShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Пользователь">
    
    
    <Grid Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock x:Name="TbTitle" Text="Пользователь" FontSize="20" HorizontalAlignment="Center" Margin="10"/>

            <Label Content="Логин"/>
            <TextBox x:Name="TbLogin"/>

            <Label Content="ФИО"/>
            <TextBox x:Name="TbFIO"/>

            <StackPanel x:Name="PanelPassword">
                <Label x:Name="LblPassword" Content="Пароль"/>
                <PasswordBox x:Name="PbPassword" ToolTip="Введите пароль"/>
            </StackPanel>

            <Label Content="Роль"/>
            <ComboBox x:Name="CmbRole" Height="30" VerticalContentAlignment="Center" DisplayMemberPath="Role_Name" SelectedValuePath="Role_Id"/>

            <Button Content="Сохранить" Click="BtnSave_Click" Width="150" Margin="0,20,0,10"/>
            <Button Content="Отмена" Click="BtnCancel_Click" Width="150"/>
           
        </StackPanel>
        

    </Grid>
</Page>
