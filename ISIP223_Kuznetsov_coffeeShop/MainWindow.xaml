<Window x:Class="ISIP223_Kuznetsov_coffeeShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP223_Kuznetsov_coffeeShop"
        mc:Ignorable="d"
        Title="Управление сетью кофеен" Height="450" Width="800"
        Background="{DynamicResource BackgroundColor}" 
        Foreground="{DynamicResource TextColor}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
   
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Button x:Name="ButtonBack"
                Content="Назад"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Width="80"
                Height="30"
                Margin="10,0,0,0"
                Click="ButtonBack_Click"/>
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"/>
        <TextBlock x:Name="Time"
                   Grid.Row="2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,15,0"
                   FontSize="14"/>
        <Button x:Name="ButtonExit"
                Grid.Row="2"
                Content="Выход" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Center" 
                Width="80" 
                Height="30" 
                Margin="10,0,0,0" 
                Click="ButtonExit_Click"/>
        <Button x:Name="ButtonTheme" 
        Content="Сменить тему" 
        Grid.Row="0"
        HorizontalAlignment="Right" 
        VerticalAlignment="Center"
        Margin="0,0,10,0"
        Width="120"
        Click="ButtonTheme_Click"/>
    </Grid>
</Window>
