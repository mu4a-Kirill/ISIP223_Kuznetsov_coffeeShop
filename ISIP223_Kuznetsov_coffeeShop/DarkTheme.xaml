<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryColor" Color="#0198AF"/>
    <SolidColorBrush x:Key="SecondaryColor" Color="#193D57"/>
    <SolidColorBrush x:Key="BackgroundColor" Color="#256569"/>
    <SolidColorBrush x:Key="TextColor" Color="#FFFFFF"/>


<Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Height" Value="35"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#1E5255"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#0198AF"/>
        <Setter Property="CaretBrush" Value="#FFFFFF"/>
    </Style>
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#1E5255"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#0198AF"/>
        <Setter Property="CaretBrush" Value="#FFFFFF"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="#1E5255"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="#1E5255"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

    <!-- Стили для DataGrid (Темная тема) -->
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="#1E5255"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="RowBackground" Value="#1E5255"/>
        <Setter Property="AlternatingRowBackground" Value="#256569"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#3A7A7E"/>
        <Setter Property="VerticalGridLinesBrush" Value="#3A7A7E"/>
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>


    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
    </Style>

</ResourceDictionary> 